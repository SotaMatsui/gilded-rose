{
  "name": "gilded-rose-kata",
  "version": "1.0.0",
  "description": "Gilded Rose kata in TypeScript",
  "scripts": {
    "clean": "rimraf dist coverage .nyc_output",
    "compile": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc --noEmit --project test/jest && tsc --noEmit --project test/mocha && tsc --noEmit --project test/vitest",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:jest": "jest",
    "test:jest:watch": "jest --watchAll",
    "test:mocha": "c8 mocha",
    "test:vitest": "vitest --coverage",
    "test:golden": "node --import tsx test/golden-master-text-test.ts"
  },
  "license": "MIT",
  "private": true,
  "devDependencies": {
    "@swc/core": "^1.16.20",
    "@swc/jest": "^0.2.39",
    "@types/chai": "^5.2.3",
    "@types/jest": "^30.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24",
    "@vitest/coverage-istanbul": "^5.0.5",
    "c8": "^12.0.0",
    "chai": "^6.3.0",
    "jest": "^30.5.2",
    "mocha": "^12.0.3",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0",
    "bun": ">=1.3.14"
  }
}
